{
  "manifest_version": 3,
  "name": "NotiRx — Companion Pharmacie",
  "version": "1.1.0",
  "description": "Boutons SMS sur Priorx pour le personnel de la pharmacie — JT Automatisation",

  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://FILL-IN-PRIORX-HOST.example/*index.aspx*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://FILL-IN-PRIORX-HOST.example/*index.aspx*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "action": {
    "default_title": "NotiRx",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
