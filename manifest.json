{
  "manifest_version": 3,
  "name": "NotiRx — Companion Pharmacie",
  "version": "1.3.0",
  "minimum_chrome_version": "109",
  "incognito": "not_allowed",
  "description": "Envoie un SMS au patient depuis Priorx : commande prête, médicament manquant, nouvelle ordonnance, renouvellement.",

  "permissions": [
    "storage"
  ],
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "host_permissions": [
    "https://4502812786.priorx.ca/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://4502812786.priorx.ca/*"],
      "js": ["priorx-search.js", "priorx-lock.js", "priorx-language.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "action": {
    "default_title": "NotiRx",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
