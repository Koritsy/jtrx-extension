{
  "manifest_version": 3,
  "name": "NotiRx — Companion Pharmacie",
  "version": "1.0.0",
  "description": "Système de notifications SMS pour les ordonnances prêtes — JT Automatisation",

  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*/*index.aspx*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["*://*/*index.aspx*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "NotiRx",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
